# Dependencies, generated builds and local tools
node_modules
.next/
out/
build/
.runtime/
next-env.d.ts
*.tsbuildinfo

# Runtime: includes music, image messages, admin credentials and room tokens
/data/
/cache/
/test-results/
*.log

# Local configuration and credentials (only the empty example is publishable)
.env*
!.env.example
*cookie*
!components/CookiesPanel.tsx
!lib/cookies.mjs
!lib/ytcookies.mjs
!app/api/admin/cookies/
*.pem
*.key
*.p12
*.pfx

