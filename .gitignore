*.mp3
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.opus
*.aiff
*.alac
*.wma

# Local archives, OS and editor files
*.tar.gz
*.zip
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
_reference/

# Personal iPhone photos
*.heic
*.heif

# Never publish private video, databases, TURN configs or tunnel credentials
*.mp4
*.mov
*.mkv
*.m4v
*.webm
*.sqlite*
*.db
/uploads/
/media/
/downloads/
/private/
/secrets/
/.cloudflared/
/cloudflared/
/coturn/
turnserver.conf
*turn-credentials*
*turn-config*

# Images belong only to reviewed app assets and sanitized documentation
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
!/public/*.png
!/public/*.jpg
!/public/*.jpeg
!/public/*.gif
!/public/*.webp
!/public/*.svg
!/public/*.ico
!/docs/screenshots/*.png
!/docs/screenshots/*.jpg
!/docs/screenshots/*.jpeg
!/docs/screenshots/*.gif
!/docs/screenshots/*.webp
!/docs/screenshots/*.svg
!/docs/screenshots/*.ico

