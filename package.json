{
  "name": "konnectivity",
  "version": "10.6.0",
  "private": true,
  "description": "Konnectivity: self-hosted music listening rooms with synchronized playback, shared playlists, video and live chat.",
  "keywords": [
    "listen-together",
    "self-hosted-music",
    "synchronized-playback",
    "listening-room",
    "shared-playlists",
    "youtube-music",
    "watch-together",
    "real-time-chat",
    "nextjs",
    "socket-io",
    "pwa"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server.mjs",
    "build": "next build --webpack",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "launch": "node scripts/launch.mjs",
    "test": "node scripts/test-client-sync.mjs",
    "test:integration": "node scripts/run-integration.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
